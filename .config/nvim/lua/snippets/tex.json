{
    "Math Document Template": {
        "prefix": "mathtemplate",
        "body": [
            "\\documentclass[12pt,a4paper]{article}",
            "",
            "% Math packages",
            "\\usepackage{amsmath}",
            "\\usepackage{amssymb}",
            "\\usepackage{amsthm}",
            "\\usepackage{mathtools}",
            "",
            "% Other useful packages",
            "\\usepackage[utf8]{inputenc}",
            "\\usepackage[T1]{fontenc}",
            "\\usepackage{geometry}",
            "\\geometry{margin=1in}",
            "",
            "% Theorem environments",
            "\\theoremstyle{plain}",
            "\\newtheorem{theorem}{Theorem}[section]",
            "\\newtheorem{lemma}[theorem]{Lemma}",
            "\\newtheorem{proposition}[theorem]{Proposition}",
            "\\newtheorem{corollary}[theorem]{Corollary}",
            "",
            "\\theoremstyle{definition}",
            "\\newtheorem{definition}[theorem]{Definition}",
            "\\newtheorem{example}[theorem]{Example}",
            "",
            "\\theoremstyle{remark}",
            "\\newtheorem{remark}[theorem]{Remark}",
            "",
            "\\title{${1:Title}}",
            "\\author{${2:Author}}",
            "\\date{${3:\\today}}",
            "",
            "\\begin{document}",
            "",
            "\\maketitle",
            "",
            "\\section{${4:Introduction}}",
            "",
            "$0",
            "",
            "\\end{document}"
        ],
        "description": "Math document template with common packages and theorem environments"
    },
    "Align(ed)": {
        "prefix": "ali",
        "body": [
            "\\begin{align*}",
            "\t$0",
            "\\end{align*}"
        ],
        "description": "Align(ed)"
    },
    "Cases": {
        "prefix": "cas",
        "body": [
            "\\begin{cases}",
            "\t${1:equation}, &\\text{ if }${2:case}\\\\\\\\",
            "\t$0",
            "\\end{cases}"
        ],
        "description": "Cases"
    },
    "Display Math — \\[ … \\]": {
        "prefix": "$$",
        "body": [
            "\\[",
            "\t$TM_SELECTED_TEXT$1",
            "\\]"
        ],
        "description": "Display Math"
    },
    "Proof": {
        "prefix": "proof",
        "body": [
            "\\begin{proof}",
            "\t$1",
            "\\end{proof}",
            "$0"
        ],
        "description": "Add a proof"
    },
    "Itemize": {
        "prefix": "item",
        "body": [
            "\\\\begin{itemize}",
            "\t\\item $1",
            "\\\\end{itemize}",
            "$0"
        ],
        "description": "Itemized environment for bulled list"
    },
    "Matrix": {
        "prefix": "mat",
        "body": [
            "\\begin{pmatrix}",
            "\t$1&$2\\\\\\\\",
            "\t$3&$4",
            "\\end{pmatrix}",
            "$0"
        ],
        "description": "2x2-Matrix"
    },
    "Vector": {
        "prefix": "vec",
        "body": [
            "\\begin{pmatrix}",
            "\t$1\\\\\\\\",
            "\t$2",
            "\\end{pmatrix}"
        ],
        "description": "Vector"
    },
    "\\begin{}…\\end{}": {
        "prefix": "begin",
        "body": [
            "\\\\begin{${1:env}}",
            "\t${1/(enumerate|itemize|list)|(description)|(.*)/${1:+\\item }${2:+\\item[] }${3:+}/}$0",
            "\\\\end{${1:env}}"
        ],
        "description": "Begin - End"
    },
    "Figure": {
        "prefix": "figure",
        "body": [
            "\\begin{figure}",
            "\t\\begin{center}",
            "\t\t\\includegraphics[width=0.95\\textwidth]{figures/$1}",
            "\t\\end{center}",
            "\t\\caption{$3}\\label{fig:$4}",
            "\\end{figure}",
            "$0"
        ],
        "description": "Add a figure"
    },
    "Table": {
        "prefix": "table",
        "body": [
            "\\begin{table}",
            "\t\\caption{$1}\\label{tab:$2}",
            "\t\\begin{center}",
            "\t\t\\begin{tabular}[c]{l|l}",
            "\t\t\t\\hline",
            "\t\t\t\\multicolumn{1}{c|}{\\textbf{$3}} & ",
            "\t\t\t\\multicolumn{1}{c}{\\textbf{$4}} \\\\\\\\",
            "\t\t\t\\hline",
            "\t\t\ta & b \\\\\\\\",
            "\t\t\tc & d \\\\\\\\",
            "\t\t\t$5",
            "\t\t\t\\hline",
            "\t\t\\end{tabular}",
            "\t\\end{center}",
            "\\end{table}",
            "$0"
        ],
        "description": "Add a table"
    },
    "Enumerate": {
        "prefix": "enumerate",
        "body": [
            "\\\\begin{enumerate}",
            "\t\\item $0",
            "\\\\end{enumerate}"
        ],
        "description": "Add a enumerate"
    },
    "Cite": {
        "prefix": "cite",
        "body": [
            "\\cite{$1}$0"
        ],
        "description": "Add a cite"
    },
    "Fraction": {
        "prefix": "frac",
        "body": [
            "\\frac{$1}{$2}$0"
        ],
        "description": "Fraction"
    },
    "Square root": {
        "prefix": "sqrt",
        "body": [
            "\\sqrt{$1}$0"
        ],
        "description": "Square root"
    },
    "Nth root": {
        "prefix": "nthroot",
        "body": [
            "\\sqrt[$1]{$2}$0"
        ],
        "description": "Nth root"
    },
    "Sum": {
        "prefix": "sum",
        "body": [
            "\\sum_{$1}^{$2}$0"
        ],
        "description": "Sum"
    },
    "Product": {
        "prefix": "prod",
        "body": [
            "\\prod_{$1}^{$2}$0"
        ],
        "description": "Product"
    },
    "Integral": {
        "prefix": "int",
        "body": [
            "\\int_{$1}^{$2}$0"
        ],
        "description": "Integral"
    },
    "Double integral": {
        "prefix": "iint",
        "body": [
            "\\iint_{$1}^{$2}$0"
        ],
        "description": "Double integral"
    },
    "Triple integral": {
        "prefix": "iiint",
        "body": [
            "\\iiint_{$1}^{$2}$0"
        ],
        "description": "Triple integral"
    },
    "Limit": {
        "prefix": "lim",
        "body": [
            "\\lim_{${1:n \\to \\infty}}$0"
        ],
        "description": "Limit"
    },
    "Partial derivative": {
        "prefix": "partial",
        "body": [
            "\\frac{\\partial ${1:f}}{\\partial ${2:x}}$0"
        ],
        "description": "Partial derivative"
    },
    "Hat": {
        "prefix": "hat",
        "body": [
            "\\hat{$1}$0"
        ],
        "description": "Hat over symbol"
    },
    "Bar": {
        "prefix": "bar",
        "body": [
            "\\bar{$1}$0"
        ],
        "description": "Bar over symbol"
    },
    "Tilde": {
        "prefix": "tilde",
        "body": [
            "\\tilde{$1}$0"
        ],
        "description": "Tilde over symbol"
    },
    "Mathbb": {
        "prefix": "bb",
        "body": [
            "\\mathbb{$1}$0"
        ],
        "description": "Blackboard bold (for sets like R, N, Z)"
    },
    "Mathcal": {
        "prefix": "cal",
        "body": [
            "\\mathcal{$1}$0"
        ],
        "description": "Calligraphic letters"
    },
    "Mathfrak": {
        "prefix": "frak",
        "body": [
            "\\mathfrak{$1}$0"
        ],
        "description": "Fraktur letters"
    },
    "Boldsymbol": {
        "prefix": "bm",
        "body": [
            "\\boldsymbol{$1}$0"
        ],
        "description": "Bold math symbol"
    },
    "Text in math": {
        "prefix": "text",
        "body": [
            "\\text{$1}$0"
        ],
        "description": "Text in math mode"
    },
    "Binomial": {
        "prefix": "binom",
        "body": [
            "\\binom{$1}{$2}$0"
        ],
        "description": "Binomial coefficient"
    },
    "Underbrace": {
        "prefix": "underbrace",
        "body": [
            "\\underbrace{$1}_{$2}$0"
        ],
        "description": "Underbrace with text"
    },
    "Overbrace": {
        "prefix": "overbrace",
        "body": [
            "\\overbrace{$1}^{$2}$0"
        ],
        "description": "Overbrace with text"
    },
    "Left right": {
        "prefix": "lr",
        "body": [
            "\\left${1:(} $2 \\right${3:)}$0"
        ],
        "description": "Left-right delimiters"
    },
    "Norm": {
        "prefix": "norm",
        "body": [
            "\\left\\| $1 \\right\\|$0"
        ],
        "description": "Norm"
    },
    "Absolute value": {
        "prefix": "abs",
        "body": [
            "\\left| $1 \\right|$0"
        ],
        "description": "Absolute value"
    },
    "Inner product": {
        "prefix": "inner",
        "body": [
            "\\langle $1, $2 \\rangle$0"
        ],
        "description": "Inner product"
    },
    "Set": {
        "prefix": "set",
        "body": [
            "\\left\\{ $1 \\right\\}$0"
        ],
        "description": "Set notation"
    },
    "Circle": {
        "prefix": "circ",
        "body": [
            "\\circ"
        ],
        "description": "Circle operator"
    },
    "Kernel": {
        "prefix": "ker",
        "body": [
            "\\mathrm{ker}$0"
        ],
        "description": "Kernel operator"
    },
    "Image": {
        "prefix": "im",
        "body": [
            "\\mathrm{im}$0"
        ],
        "description": "Image operator"
    },
    "Identity": {
        "prefix": "id",
        "body": [
            "\\mathrm{id}$0"
        ],
        "description": "Identity operator"
    },
    "Rank": {
        "prefix": "rk",
        "body": [
            "\\mathrm{rk}$0"
        ],
        "description": "Rank operator"
    },
    "Span": {
        "prefix": "span",
        "body": [
            "\\mathrm{Span}$0"
        ],
        "description": "Span operator"
    }
}
